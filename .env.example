# Скопируйте в .env и задайте свои значения: cp .env.example .env

# --- PostgreSQL ---
POSTGRES_USER=eadh
POSTGRES_PASSWORD=change_me
POSTGRES_DB=euroautodatahub_db
# Для запуска сервисов, миграций и скриптов с хост-машины
# (внутри docker-compose сервисы используют db_postgres:5432)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5433

# --- Kafka ---
# С хост-машины: localhost:9094, внутри docker-compose: kafka_broker:9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9094

# --- Парсер (Scrapy) ---
# SCRAPY_CONCURRENT_REQUESTS_PER_DOMAIN=8
# SCRAPY_DOWNLOAD_DELAY=0.1
# SCRAPY_CONSECUTIVE_403_LIMIT=3
# SCRAPY_PAUSE_DURATION=300
# SCRAPY_MAX_403_RETRIES_PER_REQUEST=3
# SCRAPY_MAX_PAUSES=5
# SCRAPY_MIN_MAKE_COMPLETENESS=0.95
# SCRAPY_LOG_LEVEL=INFO
# SCRAPY_LOG_FILE=otomoto_spider.log

# SCRAPY_MAX_PAGES_PER_SHARD=500
# SCRAPY_ROBOTSTXT_OBEY=false
# SCRAPY_RAW_RESPONSES_DIR=
# SCRAPY_RAW_RESPONSES_TTL_DAYS=14

# --- Планировщик обходов ---
CRAWL_SPIDERS=otomoto
CRAWL_AT=02:00
CRAWL_TZ=Europe/Warsaw
# CRAWL_ARGS=-a makes=audi,bmw
# RUN_ON_START=false

# --- Ingestor ---
# Объявление снимается после стольких полных обходов шарда подряд, в которых его не было
# DELIST_AFTER_MISSED_RUNS=2
# Не снимать, если за один полный обход «пропало» больше этой доли активных объявлений шарда
# MAX_DELIST_RATIO=0.3
# MIN_ADS_FOR_DELIST_GUARD=20
# LIFECYCLE_WAIT_TIMEOUT_H=6
# INGEST_BATCH_SIZE=1000

# Отчёт о прогоне в Telegram (если не задано — только в лог и crawl_run.report)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# --- API ---
# Ключи доступа к /api/v1 через запятую (заголовок X-API-Key); пусто — доступ без ключа
# API_KEYS=
