# Скопируйте в .env и задайте свои значения: cp .env.example .env

# --- PostgreSQL ---
POSTGRES_USER=eadh
POSTGRES_PASSWORD=change_me
POSTGRES_DB=euroautodatahub_db
# Для запуска сервисов, миграций и скриптов с хост-машины
# (внутри docker-compose сервисы используют db_postgres:5432)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5433

# --- Kafka ---
# С хост-машины: localhost:9094, внутри docker-compose: kafka_broker:9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9094

# --- Парсер (Scrapy) ---
# SCRAPY_CONCURRENT_REQUESTS_PER_DOMAIN=8
# SCRAPY_DOWNLOAD_DELAY=0.1
# SCRAPY_CONSECUTIVE_403_LIMIT=3
# SCRAPY_PAUSE_DURATION=300
# SCRAPY_MAX_403_RETRIES_PER_REQUEST=3
# SCRAPY_MAX_PAUSES=5
# SCRAPY_MIN_MAKE_COMPLETENESS=0.95
# SCRAPY_LOG_LEVEL=INFO
# SCRAPY_LOG_FILE=otomoto_spider.log

# --- Status updater ---
# Не снимать с публикации, если по одной марке пришлось бы снять больше этой доли объявлений
# MAX_DELIST_RATIO=0.3
# MIN_ADS_FOR_DELIST_GUARD=20
